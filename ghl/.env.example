# Riverside Fairways — GoHighLevel credentials
# Copy to .env at the repo root. Never commit the filled file.

# Riverside sub-account (Private Integration "ghl-toolkit", all scopes)
GHL_LOCATION_ID_RIVERSIDE=
GHL_PIT_RIVERSIDE=

# The template Riverside was built from — only needed to diff against it
GHL_LOCATION_ID_TEMPLATE_EVENT=
GHL_PIT_TEMPLATE_EVENT=

# Agency token. Required for writes the location PIT cannot make, notably
# PUT /locations/{id} (business profile / logoUrl) which returns 401
# "not authorized for this scope" with a location token.
GHL_PIT_AGENCY=
GHL_COMPANY_ID=

GHL_API_VERSION=2021-07-28

# Firebase browser token for extract_workflows.py only. Not a stored secret:
# it comes from a logged-in browser session and lasts about an hour.
# See ghl/build/extract_workflows.py --token-help
# GHL_TOKEN_ID=
