       "userType": "custom_sms",
       "body": "HANDOVER: {{contact.name}} ({{contact.phone}}) needs a human. Event {{contact.event_date}}. Summary: {{contact.ai_conversation_summary}}",
       "to": "{{custom_values.internal_notification_phone}}",
       "attachments": []
