     "type": "internal_notification",
     "attributes": {
      "type": "email",
      "email": {
       "isCloned": false,
       "html": "<p>The date request from <strong>{{contact.name}}</strong> for <strong>{{contact.event_date}}</strong> has not been tagged available or conflict in 4 hours.</p><p>Phone: {{contact.phone}}<br>Venue: {{contact.venue_address}}<br>Guests: {{contact.guest_count}}</p><p>Check the unit calendar and tag the contact. They are texting other vendors.</p>",
       "from_name": "{{custom_values.business_name}}",
       "from_email": "{{custom_values.business_email}}",
       "userType": "custom_email",
       "to": "{{custom_values.internal_notification_email}}",
       "subject": "Still unconfirmed: {{contact.event_date}} for {{contact.name}}",
       "attachments": []
      }
     }
    }
   ]
  },
  {
