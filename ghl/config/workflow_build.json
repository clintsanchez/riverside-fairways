       "userType": "custom_sms",
       "body": "Date request: {{contact.name}} wants {{contact.event_date}} ({{contact.event_type}}, {{contact.guest_count}} guests). Check the unit calendar and tag book-date-available or book-date-conflict.",
       "to": "{{custom_values.internal_notification_phone}}",
       "attachments": []
