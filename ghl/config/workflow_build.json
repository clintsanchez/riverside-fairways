       "isCloned": false,
       "html": "<p><strong>{{contact.name}}</strong> was handed off by the AI assistant.</p><p>Phone: {{contact.phone}}<br>Event date: {{contact.event_date}}<br>Event type: {{contact.event_type}}<br>Venue: {{contact.venue_address}}</p><p><strong>Conversation summary</strong></p><p>{{contact.ai_conversation_summary}}</p><p>Reply within the hour - they asked something the AI is not allowed to answer (price, availability, insurance, weather or contract).</p>",
       "from_name": "{{custom_values.business_name}}",
       "from_email": "{{custom_values.business_email}}",
       "userType": "custom_email",
       "to": "{{custom_values.internal_notification_email}}",
       "subject": "Handover: {{contact.name}} - {{contact.event_date}}",
       "attachments": []
      }
